{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.3",
  "default_locale": "en",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.allegro.sk/*",
        "*://*.allegro.pl/*",
        "*://*.allegro.cz/*",
        "*://*.allegro.hu/*"
      ],
      "css": ["content/early-style.css"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ]
}
